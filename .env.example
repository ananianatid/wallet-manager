# Copiez ce fichier vers `.env.local` puis renseignez vos valeurs.
# EXPO_PUBLIC_* est inliné au build et exposé dans le bundle (public par design).

# Sentry : créez un projet sur https://sentry.io puis collez son DSN ici.
# Sans DSN, l'application fonctionne normalement (journalisation locale seule).
EXPO_PUBLIC_SENTRY_DSN=

# Configuration native utilisée par le plugin Sentry pour l'upload des source maps.
# Laissez ces variables vides pour désactiver le plugin Sentry dans la configuration Expo.
SENTRY_ORG=
SENTRY_PROJECT=wallet-the-app
# Utilisé par l'upload des source maps (EAS Build uniquement).
# SENTRY_AUTH_TOKEN=
