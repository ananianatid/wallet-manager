{
  "expo": {
    "name": "Wallet Manager",
    "slug": "wallet-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wallet-logo-green-v4.png",
    "scheme": "wallettheapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/wallet-logo-foreground-v4.png",
        "monochromeImage": "./assets/images/wallet-logo-monochrome-android-v4.png",
        "backgroundColor": "#26352D"
      },
      "package": "com.ananianatid.wallettheapp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F2",
          "image": "./assets/images/wallet-logo-green-v4.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wallet accède à vos photos pour joindre un justificatif.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Déverrouiller Wallet avec Face ID."
        }
      ],
      "./plugins/with-flag-secure"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
