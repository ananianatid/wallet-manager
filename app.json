{
  "expo": {
    "name": "Wallet Manager",
    "slug": "wallet-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wallet-logo-square.png",
    "scheme": "wallettheapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/wallet-logo-square.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/wallet-logo-square.png",
        "backgroundColor": "#0A1020"
      },
      "package": "com.ananianatid.wallettheapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/wallet-logo-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F1",
          "image": "./assets/images/wallet-logo-square.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Déverrouiller Wallet avec Face ID."
        }
      ],
      "./plugins/with-flag-secure"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
